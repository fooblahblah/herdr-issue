#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: herdr-issue <issue-number>... [--plain | --ultracode]" \
        "[--model <model>] [--effort <level>]" >&2
    echo "Issue numbers may be separated by spaces or commas, and may start with #." >&2
    exit 2
}

# With no flag the mode is detected further down: superpowers when the
# Superpowers plugin is enabled, plain when it is not. --plain runs the
# prompt's own workflow and --ultracode turns the session into ultracode; both
# switch the Superpowers plugin off for the session. --model and --effort
# override the configured model and effort of this session (see
# config/defaults.json).
mode=""
model_flag=""
effort_flag=""
issues=()

# The /issue skill passes all of its arguments as one string, so split every
# argument on whitespace and commas. read -d '' keeps going past newlines and
# returns 1 at the end of its input, hence the || true.
words=()
for arg in "$@"; do
    read -r -d '' -a tokens <<<"${arg//,/ }" || true
    words+=("${tokens[@]}")
done

for ((i = 0; i < ${#words[@]}; i++)); do
    token="${words[i]}"
    case "$token" in
        --plain | --ultracode)
            [[ -z "$mode" || "$mode" == "${token#--}" ]] || usage
            mode="${token#--}"
            ;;
        --model | --effort | --model=* | --effort=*)
            if [[ "$token" == *=* ]]; then
                value="${token#*=}"
                token="${token%%=*}"
            else
                i=$((i + 1))
                value="${words[i]:-}"
            fi
            [[ -n "$value" && "$value" != --* ]] || usage
            if [[ "$token" == --model ]]; then
                model_flag="$value"
            else
                effort_flag="$value"
            fi
            ;;
        *)
            # Accept GitHub's #123 form, as in "#123, #125, #111".
            token="${token#\#}"
            [[ "$token" =~ ^[0-9]+$ ]] || usage
            token=$((10#$token))
            # A number listed twice is launched once.
            [[ " ${issues[*]} " == *" $token "* ]] || issues+=("$token")
            ;;
    esac
done

if [[ ${#issues[@]} -eq 0 ]]; then
    usage
fi

# The agent name for issue numbers joined by "_": issue-12_15_17, with
# trailing numbers dropped until it fits. Herdr caps names at 32 characters;
# two launches can only end up with the same shortened name when they share
# their first issue, which the worktree check refuses.
agent_name_for() {
    local ids="$1"
    while [[ ${#ids} -gt 26 && "$ids" == *_* ]]; do
        ids="${ids%_*}"
    done
    echo "issue-${ids}"
}

repo="$(git rev-parse --show-toplevel)"

# The plugin root is the parent of this script's directory, wherever the
# plugin is installed.
plugin_root="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"

# Models and effort levels come from the plugin's config/defaults.json, then
# the user's config, then the repository's, each merged over the last, and
# finally --model and --effort. Every file is checked before anything is
# launched, so a typo cannot silently fall back to a default.
#
# The level goes on the command line as --effort, never as an exported
# CLAUDE_CODE_EFFORT_LEVEL. That variable outranks every other effort source,
# a subagent's own `effort:` included, so exporting it pinned final-reviewer
# to the session's level (measured: with the variable set to high, an
# `effort: xhigh` agent ran at high; with --effort high, it ran at xhigh).
config_files=("$plugin_root/config/defaults.json")
for f in "${XDG_CONFIG_HOME:-$HOME/.config}/herdr-issue/config.json" \
    "$repo/.claude/herdr-issue.json"; do
    if [[ -f "$f" ]]; then
        config_files+=("$f")
    fi
done

if ! resolved="$(
    jq -n -r --arg mode "$mode" --arg model "$model_flag" --arg effort "$effort_flag" '
        def efforts: ["low", "medium", "high", "xhigh", "max"];
        # Subagents are dispatched through the Agent tool, which takes only
        # these names.
        def aliases: ["haiku", "sonnet", "opus", "fable"];
        def one_of: "must be one of \(join(", "))";
        # The session model goes on the command line, so it may also be a
        # full model ID, but never anything a shell or prompt could misread.
        def model_name: type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._\\[\\]-]*$");

        def section_errors($path; $session; $tier):
            if type != "object" then "\($path) must be a JSON object"
            else
                (keys_unsorted[] | select(IN("model", "effort") | not)
                    | "unknown key \($path).\(.)"),
                (if has("model") then
                    if $session then
                        if .model | model_name then empty
                        else "\($path).model is not a model name" end
                    elif IN(.model; aliases[]) then empty
                    else "\($path).model \(aliases | one_of)" end
                else empty end),
                # A tier effort of null means the subagent inherits the
                # session level, as it does when none is set.
                (if has("effort") then
                    if IN(.effort; efforts[]) or ($tier and .effort == null) then empty
                    else "\($path).effort \(efforts | one_of)" end
                else empty end)
            end;

        def config_errors:
            if type != "object" then "must hold a JSON object"
            else
                (keys_unsorted[]
                    | select(IN("coordinator", "ultracode_coordinator", "tiers", "final_review") | not)
                    | "unknown key \(.)"),
                (if has("coordinator") then
                    .coordinator | section_errors("coordinator"; true; false)
                else empty end),
                (if has("ultracode_coordinator") then
                    .ultracode_coordinator | section_errors("ultracode_coordinator"; true; false)
                else empty end),
                (if has("final_review") then
                    .final_review | section_errors("final_review"; false; false)
                else empty end),
                (if has("tiers") then
                    .tiers
                    | if type != "object" then "tiers must be a JSON object"
                    else
                        to_entries[]
                        | if IN(.key; "light", "standard", "heavy") then
                            .key as $tier | .value | section_errors("tiers.\($tier)"; false; true)
                        else "unknown key tiers.\(.key)" end
                    end
                else empty end)
            end;

        reduce inputs as $file ({config: {}, errors: []};
            .errors += [$file | config_errors | "\(input_filename): \(.)"]
            | if ($file | type) == "object" then .config *= $file else . end)
        | .errors += [
            (if $model == "" or ($model | model_name) then empty
                else "--model is not a model name" end),
            (if $effort == "" or IN($effort; efforts[]) then empty
                else "--effort \(efforts | one_of)" end)
        ]
        | if .errors != [] then
            "\(.errors | join("\n"))\nNothing was launched.\n" | halt_error(1)
        else .config end
        # Ultracode sessions take the coordinator model unless their own is set.
        | (if $mode == "ultracode" then
            {model: .coordinator.model} + .ultracode_coordinator
        else .coordinator end) as $session
        | ($session
            | if $model != "" then .model = $model else . end
            | if $effort != "" then .effort = $effort else . end
        ) as $session
        | $session.model, $session.effort,
          (.tiers | .light, .standard, .heavy | .model, .effort // ""),
          .final_review.model, .final_review.effort
    ' "${config_files[@]}"
)"; then
    exit 1
fi
{
    read -r session_model
    read -r session_effort
    read -r light_model
    read -r light_effort
    read -r standard_model
    read -r standard_effort
    read -r heavy_model
    read -r heavy_effort
    read -r review_model
    read -r review_effort
} <<<"$resolved"

# The names the prompt uses. Each alias names the model it currently selects
# in Claude Code; a full model ID reads as itself.
model_name() {
    case "$1" in
        opus) echo "Opus 5.5" ;;
        sonnet) echo "Sonnet 5.5" ;;
        haiku) echo "Haiku 5.5" ;;
        fable) echo "Fable 5.2" ;;
        *) echo "$1" ;;
    esac
}

# A routing tier as the prompt names it: "Sonnet 5.5", or with its own
# effort, "Opus 5.5 at medium effort".
tier_name() {
    echo "$(model_name "$1")${2:+ at $2 effort}"
}

# Make sure Herdr is available/running.
if ! herdr status server >/dev/null 2>&1; then
    echo "Herdr server is not running. Start Herdr first." >&2
    exit 1
fi

# Check every issue before creating anything, and report every problem: the
# issues share one session, so one that cannot launch holds back the rest.
worktrees="$(herdr worktree list --cwd "$repo")"
titles=()
urls=()
failed=""
for n in "${issues[@]}"; do
    # Refuse an issue that already has a worktree, alone or with others. A
    # branch names its issues as issue/<N>[_<N>...]-<slug>; match on the
    # numbers rather than the full name, so a retitled issue is still caught.
    existing="$(
        jq -c --arg n "$n" '
            def issue_numbers:
                (.branch // "")
                | (capture("^issue/(?<n>[0-9]+(_[0-9]+)*)-") | .n | split("_")) // [];
            first(
                .result.worktrees[]
                | select(any(issue_numbers[]; . == $n))
                | . + {ids: (issue_numbers | join("_"))}
            ) // empty
        ' <<<"$worktrees"
    )"

    if [[ -n "$existing" ]]; then
        wt_branch="$(jq -r '.branch' <<<"$existing")"
        wt_path="$(jq -r '.path' <<<"$existing")"
        wt_workspace="$(jq -r '.open_workspace_id // empty' <<<"$existing")"
        wt_agent="$(agent_name_for "$(jq -r '.ids' <<<"$existing")")"
        agent_status="$(
            herdr agent list |
                jq -r --arg name "$wt_agent" \
                    'first(.result.agents[] | select(.name == $name) | .agent_status) // empty'
        )"

        {
            if [[ -n "$agent_status" ]]; then
                echo "Issue #${n} is already running. No new session was started."
            else
                echo "Issue #${n} already has a worktree. No new session was started."
            fi
            echo
            echo "Workspace: ${wt_workspace:-(not open in Herdr)}"
            echo "Agent:     ${wt_agent} (${agent_status:-not running})"
            echo "Branch:    ${wt_branch}"
            echo "Worktree:  ${wt_path}"
            echo
            if [[ -n "$wt_workspace" ]]; then
                echo "Switch to workspace ${wt_workspace} in Herdr to see it."
            else
                echo "Reopen it with: herdr worktree open --cwd \"${repo}\" --path \"${wt_path}\""
            fi
            echo
        } >&2
        failed=1
        continue
    fi

    # Get authoritative issue metadata; gh explains its own failures.
    if ! issue_json="$(gh issue view "$n" --json number,title,state,url)"; then
        failed=1
        continue
    fi

    state="$(jq -r '.state' <<<"$issue_json")"
    if [[ "$state" != "OPEN" ]]; then
        echo "Issue #$n is not open ($state)." >&2
        failed=1
        continue
    fi

    titles+=("$(jq -r '.title' <<<"$issue_json")")
    urls+=("$(jq -r '.url' <<<"$issue_json")")
done

if [[ -n "$failed" ]]; then
    if [[ ${#issues[@]} -gt 1 ]]; then
        echo "Nothing was launched: these issues launch together or not at all." >&2
    fi
    exit 1
fi

# One issue keeps issue/12-<slug> and issue-12; several are joined by "_"
# (issue/12_15_17-<slug>), which never appears in a slug.
ids="${issues[*]}"
ids="${ids// /_}"
numbers="$(printf '#%s ' "${issues[@]}")"
numbers="${numbers% }"

# Every superpowers* plugin named in the user, project and local settings, and
# whether any is enabled once those files are merged (later files win).
settings_sources=()
for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" \
    "$repo/.claude/settings.json" \
    "$repo/.claude/settings.local.json"; do
    if [[ -f "$f" ]]; then
        settings_sources+=("$f")
    fi
done

superpowers_plugins="$(
    jq -n -c '
        [inputs | .enabledPlugins // {}] | add // {}
        | with_entries(select(.key | startswith("superpowers")))
    ' "${settings_sources[@]}" </dev/null
)"

mode_note=""
if [[ -z "$mode" ]]; then
    if jq -e 'any(.[]; . == true)' <<<"$superpowers_plugins" >/dev/null; then
        mode=superpowers
        mode_note=" (Superpowers plugin detected; --plain runs without it)"
    else
        mode=plain
        mode_note=" (Superpowers plugin not enabled)"
    fi
fi

# Build the prompt before creating anything, so a template mistake leaves no
# worktree behind. Section lines nest: {{#name}} keeps the lines up to its
# {{/name}} when name is active, and {{^name}} keeps them when it is not. The
# active names are the mode and, when several issues are launched, multi.
# A repository can carry its own template at
# .claude/prompts/autonomous-issue.md; otherwise the plugin's is used.
template="$repo/.claude/prompts/autonomous-issue.md"
if [[ ! -f "$template" ]]; then
    template="$plugin_root/prompts/autonomous-issue.md"
fi

# Issues branch from the remote's default branch. origin/HEAD is set by
# `git clone`; a repository without it is assumed to use main.
base="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD || true)"
base="${base#origin/}"
base="${base:-main}"

multi=""
if [[ ${#issues[@]} -gt 1 ]]; then
    multi=1
fi

# The issue URLs as one phrase for {{ISSUES}}: "A", "A and B", "A, B and C".
issues_text="${urls[0]}"
for ((i = 1; i < ${#urls[@]}; i++)); do
    if ((i == ${#urls[@]} - 1)); then
        issues_text+=" and ${urls[i]}"
    else
        issues_text+=", ${urls[i]}"
    fi
done

# Values reach awk through the environment and are replaced literally, so no
# value is ever read as a pattern or an escape.
prompt="$(
    MODE="$mode" MULTI="$multi" ISSUES="$issues_text" ISSUE_URL="${urls[0]}" \
        DEFAULT_BRANCH="$base" PR_LAND="${plugin_root}/scripts/pr-land" \
        COORDINATOR_MODEL="$(model_name "$session_model")" EFFORT="$session_effort" \
        LIGHT_MODEL="$(tier_name "$light_model" "$light_effort")" \
        STANDARD_MODEL="$(tier_name "$standard_model" "$standard_effort")" \
        HEAVY_MODEL="$(tier_name "$heavy_model" "$heavy_effort")" \
        FINAL_REVIEW_MODEL="$(model_name "$review_model")" \
        FINAL_REVIEW_ALIAS="$review_model" FINAL_REVIEW_EFFORT="$review_effort" awk '
        function fail(msg) {
            printf "%s line %d: %s\n", FILENAME, FNR, msg > "/dev/stderr"
            bad = 1
            exit 1
        }
        function replace(s, from, to,    out, i) {
            out = ""
            while ((i = index(s, from)) > 0) {
                out = out substr(s, 1, i - 1) to
                s = substr(s, i + length(from))
            }
            return out s
        }
        BEGIN {
            split("superpowers plain ultracode multi", names, " ")
            for (i in names) known[names[i]] = 1
            nvars = split("ISSUES ISSUE_URL PR_LAND DEFAULT_BRANCH COORDINATOR_MODEL EFFORT " \
                "LIGHT_MODEL STANDARD_MODEL HEAVY_MODEL FINAL_REVIEW_MODEL " \
                "FINAL_REVIEW_ALIAS FINAL_REVIEW_EFFORT", vars, " ")
            active[ENVIRON["MODE"]] = 1
            if (ENVIRON["MULTI"] != "") active["multi"] = 1
        }
        $0 ~ "^[{][{][#^/][a-z]+[}][}]$" {
            sigil = substr($0, 3, 1)
            name = substr($0, 4, length($0) - 5)
            if (!(name in known)) fail("unknown section " $0)
            if (sigil == "/") {
                if (depth == 0 || sec_name[depth] != name) fail("unmatched " $0)
                if (!sec_keep[depth]) hidden--
                depth--
            } else {
                depth++
                sec_name[depth] = name
                sec_sigil[depth] = sigil
                sec_keep[depth] = ((name in active) == (sigil == "#"))
                if (!sec_keep[depth]) hidden++
            }
            next
        }
        hidden == 0 {
            if (ENVIRON["MULTI"] != "" && index($0, "{{ISSUE_URL}}"))
                fail("{{ISSUE_URL}} names a single issue; use {{ISSUES}} to launch several")
            line = $0
            for (i = 1; i <= nvars; i++)
                line = replace(line, "{{" vars[i] "}}", ENVIRON[vars[i]])
            print line
        }
        END {
            if (bad) exit 1
            if (depth > 0) fail("{{" sec_sigil[depth] sec_name[depth] "}} is never closed")
        }
    ' "$template"
)"

# "ultracode" anywhere in a prompt opts that turn into workflows, so only the
# ultracode prompt may contain the word.
if [[ "$mode" != ultracode ]] && grep -qi ultracode <<<"$prompt"; then
    echo "The ${mode} prompt from ${template} mentions ultracode;" \
        "move that text into an {{#ultracode}} section." >&2
    exit 1
fi

# By default sessions run Opus 5.5 at high effort. Opus 5.5 thinks longer per
# turn than Opus 5 at the same level, most of all at xhigh, and its migration
# guidance reserves xhigh for work with a measured gain. Subagents inherit the
# session level unless their tier or definition sets one; the final
# whole-branch review is dispatched at its own configured level (xhigh by
# default). Ultracode sessions default to xhigh.
agent_args=(--model "$session_model" --effort "$session_effort")

# Per-session settings for the modes that run without Superpowers: every
# superpowers* plugin off, so its skills and SessionStart hook stay out of the
# session while superpowers sessions keep them, and ultracode on where asked.
# A --settings file outranks user and project settings, and it lives in the
# repo's git dir, out of git's sight.
if [[ "$mode" == ultracode ]] ||
    [[ "$mode" == plain && "$superpowers_plugins" != "{}" ]]; then
    settings_dir="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)/herdr-issue"
    mkdir -p "$settings_dir"
    session_settings="${settings_dir}/issue-${ids}.settings.json"

    jq --arg mode "$mode" '
        {enabledPlugins: map_values(false)}
        | if $mode == "ultracode" then {ultracode: true} + . else . end
    ' <<<"$superpowers_plugins" >"$session_settings"

    agent_args+=(--settings "$session_settings")
fi

# Keep branch names readable but deterministic.
slug="$(
    printf '%s' "${titles[0]}" |
        tr '[:upper:]' '[:lower:]' |
        sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' |
        cut -c1-48 |
        # The cut can land just after a word; drop the dash it leaves.
        sed -E 's/-+$//'
)"

branch="issue/${ids}-${slug}"
label="${numbers} ${titles[0]}"

# The worktree begins from the current remote default branch.
git -C "$repo" fetch origin "$base"

created="$(
    herdr worktree create \
        --cwd "$repo" \
        --branch "$branch" \
        --base "origin/${base}" \
        --label "$label" \
        --no-focus
)"

workspace_id="$(jq -r '.result.workspace.workspace_id' <<<"$created")"
tab_id="$(jq -r '.result.tab.tab_id' <<<"$created")"
pane_id="$(jq -r '.result.root_pane.pane_id' <<<"$created")"

# Give the initial layout useful names.
herdr tab rename "$tab_id" agent >/dev/null

# Handy independent shell in the same worktree.
herdr tab create \
    --workspace "$workspace_id" \
    --label shell \
    --no-focus >/dev/null

# The pane's shell may still be starting when the agent is started, so wait
# until the shell has run a command. The printf assembles the marker at run
# time, so the typed command line itself never matches.
herdr pane run "$pane_id" "printf '%s-%s\n' herdr-issue ready" >/dev/null
herdr pane wait-output "$pane_id" \
    --match "herdr-issue-ready" \
    --timeout 30000 >/dev/null

agent_name="$(agent_name_for "$ids")"

# The shell can still be redrawing its prompt after the marker prints, and
# `agent start` refuses a pane that is not at an idle prompt, so retry while
# Herdr reports the pane busy.
for attempt in $(seq 1 30); do
    if start_err="$(
        herdr agent start "$agent_name" \
            --kind claude \
            --pane "$pane_id" \
            --timeout 120000 \
            -- \
            "${agent_args[@]}" 2>&1 >/dev/null
    )"; then
        break
    fi
    if [[ "$start_err" != *agent_pane_busy* || "$attempt" -eq 30 ]]; then
        echo "Could not start the agent in pane ${pane_id} (workspace ${workspace_id}):" >&2
        echo "$start_err" >&2
        exit 1
    fi
    sleep 1
done

# Name the issues on the sidebar line under the workspace, where the agent
# name would show; the agent keeps its name. The plugin's hook adds the PR
# once there is one (scripts/show-pr). Display only, so a failure just warns.
if [[ -n "$multi" ]]; then
    sidebar="$(printf ', #%s' "${issues[@]}")"
    sidebar="Issues: ${sidebar:2}"
else
    sidebar="Issue: #${issues[0]}"
fi
if ! herdr pane report-metadata "$pane_id" \
    --source herdr-issue \
    --display-agent "$sidebar" >/dev/null; then
    echo "Warning: could not name the issue${multi:+s} in Herdr's sidebar." >&2
fi

# Submit and return immediately. Herdr owns the running agent from here.
herdr agent prompt "$agent_name" "$prompt" >/dev/null

# Mark the issues as being worked on, only once a session is actually running.
# "@me" resolves to whoever gh is logged in as, so each launcher assigns
# themselves. The session is already up, so a failure here only warns.
for n in "${issues[@]}"; do
    if ! gh issue edit "$n" --add-assignee @me >/dev/null; then
        echo "Warning: could not assign issue #${n} to you; assign it by hand." >&2
    fi
done

cat <<EOF
Launched issue${multi:+s} ${numbers}

Workspace: ${workspace_id}
Agent:     ${agent_name}
Branch:    ${branch}
Mode:      ${mode}${mode_note}
Model:     ${session_model} (${session_effort} effort)
$(printf 'Issue:     %s\n' "${urls[@]}")

The Claude session is running independently in Herdr.
EOF
